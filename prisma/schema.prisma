generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id            String        @id @default(cuid())
  custName      String
  custPhone     String
  vehicle       String
  plateNumber   String?
  complaint     String
  serviceType   ServiceType   @default(LIGHT_SERVICE)
  status        OrderStatus   @default(PENDING)
  scheduledAt   DateTime?
  items         Json?
  totalPrice    Decimal       @default(0) @db.Decimal(12, 2)
  totalPaid     Decimal       @default(0) @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(UNPAID)
  mechanicId    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  feedback      String?
  rating        Int?
  mechanic      Employee?     @relation(fields: [mechanicId], references: [id])
  orderFees     OrderFee[]
  orderItems    OrderItem[]
  payments      Payment[]

  @@index([status])
  @@index([scheduledAt])
  @@index([mechanicId])
}

model OrderItem {
  id          String     @id @default(cuid())
  orderId     String
  itemType    String
  itemName    String
  quantity    Int        @default(1)
  unitPrice   Decimal    @db.Decimal(12, 2)
  totalPrice  Decimal    @db.Decimal(12, 2)
  sparePartId String?
  createdAt   DateTime   @default(now())
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sparePart   SparePart? @relation(fields: [sparePartId], references: [id])

  @@index([orderId])
  @@index([sparePartId])
}

model OrderFee {
  id          String    @id @default(cuid())
  orderId     String
  employeeId  String
  amount      Decimal   @db.Decimal(12, 2)
  description String?
  isPaid      Boolean   @default(false)
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  employee    Employee  @relation(fields: [employeeId], references: [id])
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([employeeId])
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  password               String
  role                   String
  employeeId             String?                 @unique
  resetToken             String?                 @unique
  resetTokenExpiry       DateTime?
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  forgotPasswordRequests ForgotPasswordRequest[]
  employee               Employee?               @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([role])
}

model ForgotPasswordRequest {
  id         String    @id @default(cuid())
  userId     String
  status     String    @default("PENDING")
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Employee {
  id             String     @id @default(cuid())
  name           String
  role           String
  phone          String?
  salaryType     SalaryType @default(DAILY)
  dailyRate      Decimal    @default(0) @db.Decimal(10, 2)
  commissionRate Decimal    @default(0) @db.Decimal(10, 2)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  orders         Order[]
  orderFees      OrderFee[]
  payrolls       Payroll[]
  user           User?
}

model Payroll {
  id          String        @id @default(cuid())
  startDate   DateTime
  endDate     DateTime
  employeeId  String
  baseSalary  Decimal       @default(0) @db.Decimal(12, 2)
  bonus       Decimal       @default(0) @db.Decimal(12, 2)
  totalEarned Decimal       @db.Decimal(12, 2)
  details     String?
  totalPaid   Decimal       @default(0) @db.Decimal(12, 2)
  status      PaymentStatus @default(UNPAID)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  payments    Payment[]
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([startDate, endDate])
}

model BankAccount {
  id             String    @id @default(cuid())
  bankCode       String    @default("OTHER") // Kode bank (BCA, BNI, BRI, etc.)
  bankName       String    // Nama lengkap bank
  accountNumber  String
  accountName    String
  currentBalance Decimal   @default(0) @db.Decimal(15, 2) // Saldo saat ini
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  payments       Payment[]

  @@index([bankCode])
}

model Payment {
  id            String        @id @default(cuid())
  date          DateTime      @default(now())
  amount        Decimal       @db.Decimal(12, 2)
  note          String?
  orderId       String?
  payrollId     String?
  createdAt     DateTime      @default(now())
  bankAccountId String?
  paymentMethod String        @default("CASH")
  journal       JournalEntry?
  bankAccount   BankAccount?  @relation(fields: [bankAccountId], references: [id])
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payroll       Payroll?      @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([payrollId])
  @@index([date])
  @@index([bankAccountId])
}

model ContentSection {
  id         String   @id @default(cuid())
  sectionKey String   @unique
  title      String?
  subtitle   String?
  content    Json?
  imageUrl   String?
  isVisible  Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

model Account {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  type         String
  category     String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  journalItems JournalItem[]

  @@index([type])
}

model JournalEntry {
  id          String        @id @default(cuid())
  date        DateTime      @default(now())
  description String
  reference   String?
  paymentId   String?       @unique
  createdAt   DateTime      @default(now())
  payment     Payment?      @relation(fields: [paymentId], references: [id])
  items       JournalItem[]

  @@index([date])
}

model JournalItem {
  id             String       @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Decimal      @default(0) @db.Decimal(12, 2)
  credit         Decimal      @default(0) @db.Decimal(12, 2)
  account        Account      @relation(fields: [accountId], references: [id])
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@index([journalEntryId])
  @@index([accountId])
}

model SparePart {
  id         String      @id @default(cuid())
  code       String      @unique
  name       String
  stock      Int         @default(0)
  minStock   Int         @default(5)
  unit       String
  buyPrice   Decimal     @db.Decimal(10, 2)
  sellPrice  Decimal     @db.Decimal(10, 2)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orderItems OrderItem[]

  @@index([stock])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  title     String
  details   String
  metadata  Json?
  userId    String?
  userName  String?
  role      String?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

model MediaGallery {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String   // URL gambar yang di-upload
  type        MediaType @default(GALLERY) // GALLERY, POSTER, BANNER
  category    String?  // Kategori: "service", "project", "event", dll
  isActive    Boolean  @default(true)
  displayOrder Int     @default(0) // Urutan tampilan
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([isActive])
  @@index([displayOrder])
}

model SocialEmbed {
  id          String      @id @default(cuid())
  platform    SocialPlatform // INSTAGRAM, TIKTOK
  embedUrl    String      // URL post Instagram/TikTok
  embedCode   String?     // Embed code jika ada
  title       String?
  description String?
  thumbnail   String?     // URL thumbnail preview
  isActive    Boolean     @default(true)
  displayOrder Int        @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([platform])
  @@index([isActive])
  @@index([displayOrder])
}

enum MediaType {
  GALLERY
  POSTER
  BANNER
  CAROUSEL
}

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
}

enum OrderStatus {
  PENDING
  ESTIMATED
  CONFIRMED
  QUEUE
  IN_PROGRESS
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum ServiceType {
  LIGHT_SERVICE
  MODIFICATION
}

enum SalaryType {
  DAILY
  COMMISSION
}
