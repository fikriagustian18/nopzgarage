generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  password         String
  role             String
  employeeId       String?   @unique
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  forgotRequests   Json?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  employee         Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([role])
}

model Employee {
  id             String      @id @default(cuid())
  name           String
  role           String
  phone          String?
  jabatan        String?
  salaryType     SalaryType  @default(DAILY)
  dailyRate      Decimal     @default(0) @db.Decimal(10, 2)
  commissionRate Decimal     @default(0) @db.Decimal(10, 2)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User?
  orders         Order[]
  orderItems     OrderItem[]
  payments       Payment[]
}

model Order {
  id            String        @id @default(cuid())
  custName      String
  custPhone     String
  vehicle       String
  plateNumber   String?
  complaint     String
  serviceType   ServiceType   @default(LIGHT_SERVICE)
  status        OrderStatus   @default(PENDING)
  scheduledAt   DateTime?
  items         Json?
  totalPrice    Decimal       @default(0) @db.Decimal(12, 2)
  totalPaid     Decimal       @default(0) @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(UNPAID)
  mechanicId    String?
  feedback      String?
  rating        Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  mechanic      Employee?     @relation(fields: [mechanicId], references: [id])
  orderItems    OrderItem[]
  payments      Payment[]

  @@index([status])
  @@index([scheduledAt])
  @@index([mechanicId])
}

model OrderItem {
  id          String     @id @default(cuid())
  orderId     String
  itemType    String
  itemName    String
  quantity    Int        @default(1)
  unitPrice   Decimal    @db.Decimal(12, 2)
  totalPrice  Decimal    @db.Decimal(12, 2)
  sparePartId String?
  employeeId  String?
  isPaid      Boolean    @default(false)
  createdAt   DateTime   @default(now())
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sparePart   SparePart? @relation(fields: [sparePartId], references: [id])
  employee    Employee?  @relation(fields: [employeeId], references: [id])

  @@index([orderId])
  @@index([sparePartId])
  @@index([employeeId])
}

model SparePart {
  id         String      @id @default(cuid())
  code       String      @unique
  name       String
  category   String?     @default("Oli")
  stock      Int         @default(0)
  minStock   Int         @default(5)
  unit       String
  buyPrice   Decimal     @db.Decimal(10, 2)
  sellPrice  Decimal     @db.Decimal(10, 2)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orderItems OrderItem[]

  @@index([stock])
  @@index([category])
}

model Account {
  id             String    @id @default(cuid())
  code           String    @unique
  name           String
  type           String
  category       String?
  bankCode       String?   @default("OTHER")
  accountNumber  String?
  accountName    String?
  currentBalance Decimal   @default(0) @db.Decimal(15, 2)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  payments       Payment[]

  @@index([type])
}

model Payment {
  id            String    @id @default(cuid())
  date          DateTime  @default(now())
  amount        Decimal   @db.Decimal(12, 2)
  type          String    @default("ORDER_PAYMENT")
  note          String?
  orderId       String?
  employeeId    String?
  bankAccountId String?
  paymentMethod String    @default("CASH")
  journalItems  Json?
  createdAt     DateTime  @default(now())
  order         Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  employee      Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  bankAccount   Account?  @relation(fields: [bankAccountId], references: [id])

  @@index([orderId])
  @@index([employeeId])
  @@index([date])
  @@index([bankAccountId])
}

model SystemConfig {
  id           String   @id @default(cuid())
  category     String   @default("SETTING")
  key          String?  @unique
  title        String?
  subtitle     String?
  content      Json?
  imageUrl     String?
  embedUrl     String?
  platform     String?
  userId       String?
  userName     String?
  isVisible    Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([key])
}

enum OrderStatus {
  PENDING
  ESTIMATED
  CONFIRMED
  QUEUE
  IN_PROGRESS
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum ServiceType {
  LIGHT_SERVICE
  MODIFICATION
}

enum SalaryType {
  DAILY
  COMMISSION
  MONTHLY
}
